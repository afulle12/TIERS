# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# ─── IDE / editor ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── Secrets & local config ──────────────────────────────
.env
.env.local
*.pem
*.key
secrets/

# ─── Raw source datasets (not versioned; download separately) ─────
# Several upstream datasets have licenses that restrict bulk redistribution.
# See README.md and DATA_PROVENANCE.md for download links.
data/raw/

# ─── Generated processed data (regenerable) ─────────────
# Ignore large generated CSVs; rebuild via the pipeline.
data/processed/conflict_dyads_full.csv
data/processed/dyads_with_features.csv
data/processed/conflict_dyads_midb_only.csv
data/processed/*.tmp

# ─── Output (regenerable) ───────────────────────────────
output/
!output/.gitkeep

# ─── LibreOffice / spreadsheet lock files ────────────────
*.~lock.*
.~lock.*

# ─── OS / temporary ─────────────────────────────────────
tmp/
!tmp/.gitkeep
*.bak
*.orig
*.rej
Thumbs.db

# ─── Logs ───────────────────────────────────────────────
*.log
logs/

# ─── Build / distribution ───────────────────────────────
build/
dist/
*.egg
